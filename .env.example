# ---------------------------------------------------------------------------
# MedExplain — Docker Compose environment
#
# Copy this file to `.env`, generate an APP_KEY, and adjust any secrets:
#
#   cp .env.example .env
#   echo "APP_KEY=$(openssl rand -base64 32)" >> .env
#   docker compose up --build -d
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=MedExplain
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
# Required. Generate with:  openssl rand -base64 32
APP_KEY=

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=medexplain
DB_USERNAME=medexplain
DB_PASSWORD=medexplain
DB_ROOT_PASSWORD=root

# --- Runtime drivers (database-backed; Redis reserved for scale-out) ---
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
FILESYSTEM_DISK=local

# --- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=MedExplain

# --- AI service ---
# Shared secret used for X-Service-Key. Change in production!
FASTAPI_API_KEY=dev-secret-change-me
FASTAPI_TIMEOUT=120
LLM_PROVIDER=openrouter
# OpenRouter credentials
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Ports ---
APP_PORT=80