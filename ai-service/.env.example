# Shared secret between Laravel and this service (constant-time compared).
FASTAPI_API_KEY=dev-secret-change-me

# stub (default, keyless) | openai | openrouter | agentrouter
LLM_PROVIDER=stub

# Provider credentials and endpoints. openrouter_*/agentrouter_* values fall
# back to the openai_* equivalents when unset, so a single key still works.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible endpoint base URL (e.g. OpenRouter: https://openrouter.ai/api/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional provider-specific overrides.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# Gateway tuning (see docs/ai-architecture-blueprint.md §4.7).
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF=1.5
# Ordered fallback list; "stub" is always the keyless last resort.
# LLM_FALLBACK=agentrouter,openai,stub
# Task -> provider/model routing, e.g. "explain:agentrouter/gpt-5.6-sol,extract:openai/gpt-4o-mini"
# LLM_ROUTING=

# Max accepted upload size in MB.
MAX_UPLOAD_MB=10

# Reported by GET /api/v1/health
SERVICE_VERSION=0.1.0